# Copy this file to ".env" and fill in what you need. Everything is optional.

# Enables AI-powered ideas and open-ended chat answers (get a key at https://console.anthropic.com).
# Leave empty to run fully offline with the built-in planner.
ANTHROPIC_API_KEY=

# Model used for AI features.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Server
HOST=127.0.0.1
PORT=8000

# Limits (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10

# Seconds to wait for the AI before falling back to built-in answers
AI_TIMEOUT_SECONDS=30
